APP_NAME=PictureShow
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=photos
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19000
MINIO_PUBLIC_SECURE=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FASTSTART_ENABLED=true
VIDEO_TRANSCODE_NON_BROWSER_FRIENDLY=true
VIDEO_FASTSTART_TIMEOUT_SECONDS=3600
VIDEO_TRANSCODE_TIMEOUT_SECONDS=21600
VIDEO_COVER_CAPTURE_SECONDS=1
VIDEO_PRESIGNED_URL_EXPIRES_SECONDS=21600
VIDEO_USE_PRESIGNED_PLAY_URL=true
VIDEO_AUTO_SEEK_OPTIMIZE_ON_UPLOAD=true
VIDEO_SEEK_OPTIMIZE_CODEC_POLICY=preserve
VIDEO_SEEK_KEYFRAME_INTERVAL_SECONDS=1
VIDEO_SEEK_OPTIMIZE_THRESHOLD_SECONDS=2.5
VIDEO_TRANSCODE_ACCELERATOR=nvenc
VIDEO_TRANSCODE_FALLBACK_TO_CPU=true
VIDEO_SEEK_TRANSCODE_CRF=21
VIDEO_SEEK_TRANSCODE_PRESET=veryfast
SUBTITLE_ASR_MODEL_PATH=path/to/faster-whisper-model
SUBTITLE_ASR_DEVICE=cuda
SUBTITLE_ASR_COMPUTE_TYPE=int8_float16
SUBTITLE_ASR_UNLOAD_AFTER_TRANSCRIBE=true
SUBTITLE_TRANSLATION_PROVIDER=local_hymt2
SUBTITLE_TRANSLATION_BASE_URL=http://127.0.0.1:8081/v1
SUBTITLE_TRANSLATION_MODEL=Hy-MT2-1.8B-Q4_K_M
SUBTITLE_TRANSLATION_MODEL_PATH=path/to/translation-model.gguf
SUBTITLE_TRANSLATION_TIMEOUT_SECONDS=600
SUBTITLE_BATCH_SIZE=3
SUBTITLE_LLAMA_SERVER_PATH=path/to/llama-server.exe
SUBTITLE_LLAMA_SERVER_THREADS=16
SUBTITLE_LLAMA_SERVER_CONTEXT_SIZE=4096
SUBTITLE_LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=300
SUBTITLE_LLAMA_SERVER_LOG_PATH=data/logs/subtitle-llama-server.log
SUBTITLE_LLAMA_SERVER_LOG_VERBOSITY=1
SUBTITLE_LLAMA_SERVER_DEVICE=none
SUBTITLE_LLAMA_SERVER_GPU_LAYERS=0
SUBTITLE_LLAMA_SERVER_WARMUP=false
DATABASE_URL=sqlite:///E:/dockerVolums/picture-show/sqllite/app.db
DATA_DIR=E:/dockerVolums/picture-show/sqllite
CORS_ORIGINS=["http://localhost:5173"]
QDRANT_HOST=127.0.0.1
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_PREFER_GRPC=true
QDRANT_KNOWN_COLLECTION=pictureshow_known_faces_adaface_ir101_wf12m_v1_fliptta
QDRANT_VECTOR_DIMENSION=512
GALLERY_SIMILARITY_MODEL_PATH=E:/AI-MODELS/vision/dinov2-base
GALLERY_SIMILARITY_MODEL_VERSION=dinov2-base-v1
GALLERY_SIMILARITY_DEVICE=cuda
GALLERY_SIMILARITY_BATCH_SIZE=32
GALLERY_SIMILARITY_VECTOR_DIMENSION=768
GALLERY_SIMILARITY_QDRANT_COLLECTION=pictureshow_gallery_similarity_dinov2_base_v1
GALLERY_SIMILARITY_NEAR_THRESHOLD=0.92
GALLERY_SIMILARITY_SCENE_THRESHOLD=0.88
GALLERY_SIMILARITY_QUALITY_VERSION=technical-quality-v2
GALLERY_SIMILARITY_QUALITY_MIN_MARGIN=3.0
GALLERY_SIMILARITY_AUTO_DELETE_THRESHOLD=0.985
GALLERY_SIMILARITY_AUTO_DELETE_PERCEPTUAL_MIN=0.96
ACQUISITION_DOWNLOAD_WORKERS=8
ACQUISITION_DOWNLOAD_TIMEOUT_SECONDS=30
ACQUISITION_DOWNLOAD_RETRIES=3
ACQUISITION_MAX_FILE_BYTES=104857600
ACQUISITION_QUALITY_MIN_PIXELS=262144
ACQUISITION_QUALITY_MAX_ASPECT_RATIO=4
ACQUISITION_QUALITY_BLUR_THRESHOLD=45
ACQUISITION_EXPORT_TTL_HOURS=24
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_MAX_MEDIA_BYTES=2147483648
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=600
TELEGRAM_FLOOD_WAIT_MAX_SECONDS=3600
GALLERY_RECOGNITION_WORKERS=2
IMAGE_COMPUTE_LIBRARY_THREADS=4
IMAGE_COMPUTE_THUMBNAIL_PARALLEL=2
THUMBNAIL_CACHE_SIZE=256
FACE_MODEL_NAME=buffalo_l
FACE_ADAPTER_ID=adaface-r101
FACE_RECOGNITION_MODEL_PATH=E:/AI-MODELS/face/adaface-ir101/adaface_ir_101.onnx
FACE_EMBEDDING_VERSION=adaface-ir101-wf12m-v1-fliptta
FACE_EXECUTION_PROVIDERS=CPUExecutionProvider
FACE_REQUIRE_PRIMARY_PROVIDER=false
FACE_DETECTION_SIZE=640
FACE_SEARCH_LIMIT=50
